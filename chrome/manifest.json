{
  "manifest_version": 3,
  "name": "quotexbot",
  "version": "0.9.37",
  "description": "DEMO HUD on the open Quotex chart: Tesseract OCR of the visible chart-axis live tag. No cookies/SSID.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://market-qx.info/*",
    "https://*.market-qx.info/*",
    "http://market-qx.info/*",
    "http://*.market-qx.info/*",
    "https://market-qx.com/*",
    "https://*.market-qx.com/*",
    "https://broker-qx.com/*",
    "https://*.broker-qx.com/*",
    "https://broker-qx.info/*",
    "https://*.broker-qx.info/*",
    "https://qxbroker.com/*",
    "https://*.qxbroker.com/*",
    "https://quotex.com/*",
    "https://*.quotex.com/*",
    "https://quotex.app/*",
    "https://*.quotex.app/*",
    "https://market-qx.io/*",
    "https://*.market-qx.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*",
        "offscreen.html",
        "offscreen.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://market-qx.info/*",
        "https://*.market-qx.info/*",
        "http://market-qx.info/*",
        "http://*.market-qx.info/*",
        "https://market-qx.com/*",
        "https://*.market-qx.com/*",
        "https://broker-qx.com/*",
        "https://*.broker-qx.com/*",
        "https://broker-qx.info/*",
        "https://*.broker-qx.info/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://quotex.app/*",
        "https://*.quotex.app/*",
        "https://market-qx.io/*",
        "https://*.market-qx.io/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
